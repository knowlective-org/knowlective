# Settings for docker-compose.prod.yml. `./install.sh` writes .env.production
# interactively; or copy this file to .env.production and fill it in:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Generate KNOWLECTIVE_SERVER_KEY with `openssl rand -base64 32` (or
# `pnpm gen:server-key`), the others with `openssl rand -hex 32`.
# Never commit the filled-in file.

# Database: use ONE of the two blocks below.
#
# (a) Bundled PostgreSQL. The password is used in a connection URL: letters
#     and digits only (`openssl rand -hex 32`).
COMPOSE_PROFILES="bundled-db"
POSTGRES_PASSWORD=""
#
# (b) A PostgreSQL you run yourself (16 or later recommended). Comment out
#     both lines of (a) and set the URL. Percent-encode special characters
#     in the user name and password. The user needs to create tables
#     (migrations run on startup). From the container, "localhost" is the
#     container itself: use the server's address.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Semantic search (pages close in meaning, not only those with the same
# words): optional. To use the bundled vector database, add
# "bundled-vectordb" to COMPOSE_PROFILES (e.g. "bundled-db,bundled-vectordb")
# and set its password (letters and digits). Or set VECTOR_DATABASE_URL to a
# PostgreSQL with pgvector of your own. Neither = search by words only.
# VECTORDB_PASSWORD=""
# VECTOR_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Server key that unlocks the data encryption key (32 bytes, base64).
# Keep it secret and back it up: losing it AND the master password makes
# page data unrecoverable.
KNOWLECTIVE_SERVER_KEY=""

# Bundled SeaweedFS S3 credentials (file attachments), letters and digits.
SEAWEEDFS_ACCESS_KEY=""
SEAWEEDFS_SECRET_KEY=""

# Host address and port the app listens on. Keep 127.0.0.1 when the reverse
# proxy runs on this server. Otherwise use this server's private address (e.g.
# 10.0.0.5; 0.0.0.0 = every address) and let only the proxy reach the port:
# whoever reaches it directly can fake X-Forwarded-For, which the rate limits
# and IP restrictions rely on. IPv6 in brackets, e.g. [::].
# KNOWLECTIVE_BIND=127.0.0.1
# KNOWLECTIVE_PORT=3000

# Reverse proxies in front of the app that append to X-Forwarded-For.
# KNOWLECTIVE_TRUSTED_PROXY_HOPS=1

# Sub-path the app is served under, when the reverse proxy publishes it at
# e.g. https://example.com/knowlective/ (pages, /admin, /api and the collaboration
# WebSocket are all under it). The proxy must pass the path on unchanged, not
# strip it. Empty = served from the root. Applied when the container starts.
# KNOWLECTIVE_BASE_PATH=/knowlective

# Published source of a modified version (AGPL-3.0). Default: upstream.
# KNOWLECTIVE_SOURCE_URL="https://github.com/knowlective-org/knowlective"

# Time zone for dates shown in /admin.
# TZ=Asia/Tokyo
