DATABASE_URL="postgresql://yosuga:yosuga@localhost:5432/yosuga"
REDIS_URL="redis://localhost:6379"
# Port for the app (web pages + collaboration WebSocket at /collab). Default 3000.
# PORT=3000

# Server key that unlocks the data encryption key. Generate with `pnpm gen:server-key`.
# Keep it secret and back it up: losing it AND the master password makes page data unrecoverable.
YOSUGA_SERVER_KEY=""

# Number of reverse proxies in front of the web app that append to
# X-Forwarded-For (default 1). The admin IP allowlist and login lockout rely on
# it. Never expose Next.js directly to the internet: client IPs become spoofable.
# YOSUGA_TRUSTED_PROXY_HOPS=1

# Source code shown in the admin console ("ソースコード" link). yosuga is
# AGPL-3.0: if you run a modified version, point this at your published
# source (default: the upstream repository).
# YOSUGA_SOURCE_URL="https://github.com/hachibay/yosuga"

# Bundled SeaweedFS (docker-compose.yml) S3 credentials, also used by the app
# as the default file storage until another S3-compatible storage is set in
# /admin. Generate each with `pnpm gen:server-key` (letters, digits, + / =
# only). Put the same values in apps/web/.env.local.
SEAWEEDFS_ACCESS_KEY=""
SEAWEEDFS_SECRET_KEY=""
# Where the app reaches the bundled SeaweedFS S3 API (default http://localhost:8333).
# YOSUGA_BUNDLED_S3_ENDPOINT="http://localhost:8333"
