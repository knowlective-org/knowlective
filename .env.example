DATABASE_URL="postgresql://yosuga:yosuga@localhost:5432/yosuga"
REDIS_URL="redis://localhost:6379"
# Port for the app (web pages + collaboration WebSocket at /collab). Default 3000.
# PORT=3000

# Server key that unlocks the data encryption key. Generate with `pnpm gen:server-key`.
# Keep it secret and back it up: losing it AND the master password makes page data unrecoverable.
YOSUGA_SERVER_KEY=""

# Number of reverse proxies in front of the web app that append to
# X-Forwarded-For (default 1). The admin IP allowlist and login lockout rely on
# it. Never expose Next.js directly to the internet: client IPs become spoofable.
# YOSUGA_TRUSTED_PROXY_HOPS=1
