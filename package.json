{
  "name": "knowlective",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "start": "pnpm --filter web start",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter shared prisma generate",
    "db:migrate": "pnpm --filter shared prisma migrate dev",
    "db:seed": "pnpm --filter shared prisma:seed",
    "gen:server-key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "gen:storage-key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "rotate-server-key": "pnpm --filter shared rotate-server-key",
    "admin:recover": "pnpm --filter shared admin:recover",
    "e2e:seed": "pnpm --filter shared e2e:seed",
    "e2e": "pnpm e2e:seed && pnpm --filter web e2e",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
