generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Site-wide role, independent of page permissions.
// - SITE_ADMIN: everything in /admin except server-side work (master
//   password, server key, recovery CLI). Can't read pages without a group grant.
// - CONTENT_MANAGER: creates knowledge roots, invites users (as
//   CONTENT_MANAGER or USER), edits groups within trees it manages. In /admin
//   it only sees invitations and groups.
// - USER: no /admin access.
enum SiteRole {
  SITE_ADMIN
  CONTENT_MANAGER
  USER
}

// What a group may do with a page and (by inheritance) its descendants.
// MANAGE also allows changing the tree's group grants.
enum PageAccess {
  VIEW
  EDIT
  MANAGE
}

model User {
  id           String    @id @default(cuid())
  // Email address, encrypted with the DEK (src/personal-data.ts). emailHash
  // (keyed HMAC of the normalized address) is what lookups and uniqueness
  // use. Set on every account except the seed's demo user (no address).
  emailHash    Bytes?    @unique
  emailEnc     Bytes?
  // Plaintext address of an account from before the encryption; the server
  // moves it into the columns above at startup and clears it.
  legacyEmail  String?
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  // Set when an admin disables the account: no login, sessions ended,
  // collab access refused. Group memberships are kept so re-enabling restores access.
  disabledAt   DateTime?
  siteRole     SiteRole  @default(USER)
  // Page opened most recently; "/" reopens it (if still accessible). No
  // foreign key: a deleted page simply falls back to the first visible one.
  lastPageId   String?
  // The order this user wants their knowledge roots in, in the sidebar
  // (KnowledgeRoot ids). Roots not listed follow, oldest first. Empty = all
  // in creation order.
  rootOrder    String[]  @default([])

  pages           Page[]          @relation("PageCreatedBy")
  updatedPages    Page[]          @relation("PageUpdatedBy")
  deletedPages    Page[]          @relation("PageDeletedBy")
  lockedPages     Page[]          @relation("PageLockedBy")
  personalRoot    KnowledgeRoot?  @relation("PersonalRoot")
  sessions        UserSession[]
  usedInvitations Invitation[]
  passwordResets  PasswordResetToken[]
  groups          GroupMember[]
  uploadedFiles   FileObject[]
  adminSessions   AdminSession[]

  // TOTP secret for this user's two-step verification, encrypted with the DEK
  // (AAD bound to the user id). Required for site admins signing in to /admin.
  totpSecret   Bytes?
  // Last accepted TOTP time step, so a code can't be replayed.
  totpLastStep Int?

  // OpenID Connect account this user signs in with: the IdP's `sub` claim,
  // stored on the first sign-in (new account or matched by verified email).
  // `sub` is only unique per IdP, hence the issuer next to it.
  oidcIssuer  String?
  oidcSubject String?

  @@unique([oidcIssuer, oidcSubject])
}

// A knowledge root: the container that owns members,
// permissions and invitations for one page tree. In the UI it appears as its
// root page — the root's name is the root page's title.
//
//   KnowledgeRoot ── rootPage (page1)
//                      └ page1-1
//                          └ page1-1-1
model KnowledgeRoot {
  id         String   @id @default(cuid())
  // The root page. Nullable only because the root and its page reference
  // each other and must be created in two steps; createKnowledgeRoot() always
  // sets it in the same transaction, and the root page is never deleted.
  rootPageId String?  @unique
  rootPage   Page?    @relation("KnowledgeRootPage", fields: [rootPageId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  // Set on a user's personal knowledge root (one per account, made with it):
  // only this user can open its pages, and grants are never used for it
  // (packages/shared/src/permissions.ts). Removed with the account
  // (deletePersonalRoot), so no foreign-key action here.
  ownerId    String?  @unique
  owner      User?    @relation("PersonalRoot", fields: [ownerId], references: [id], onDelete: Restrict)

  // Every page in the tree, including the root page.
  pages Page[]       @relation("KnowledgeRootPages")
  files FileObject[]
}

// Page hierarchy / metadata lives here. The actual block content lives in the
// Yjs document referenced by PageDocument — Postgres never parses block content.
model Page {
  id        String    @id @default(cuid())
  title     String    @default("Untitled")
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Set when the page is moved to the trash. Its descendants keep null but
  // are hidden too (the tree walk never passes a deleted page), so restoring
  // brings back the whole subtree. A descendant deleted on its own before
  // stays in the trash as a separate item.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("PageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // The knowledge root this page belongs to, stored on every page (not just
  // the root page) so permission checks never have to walk up the tree.
  rootId String
  root   KnowledgeRoot  @relation("KnowledgeRootPages", fields: [rootId], references: [id])
  // Set on the root page only.
  rootOf KnowledgeRoot? @relation("KnowledgeRootPage")

  // Null only for a root page; every other page has a parent.
  parentId String?
  parent   Page?   @relation("PageToPage", fields: [parentId], references: [id])
  children Page[]  @relation("PageToPage")
  // Position among its siblings (ascending; ties by createdAt). Set to the
  // end on creation, renumbered for all siblings when a page is dragged in.
  sortOrder Int @default(0)

  createdById String
  createdBy   User   @relation("PageCreatedBy", fields: [createdById], references: [id])
  // Last user whose edit was stored (body or title via collab, or a property
  // value). Null for pages nobody has edited since this column was added.
  updatedById String?
  updatedBy   User?   @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Set while the page is locked: read-only for everyone until unlocked by
  // someone with EDIT on it. With lockSubtree, everything under the page is
  // locked too (packages/shared/src/permissions.ts, computeLocks).
  lockedAt    DateTime?
  lockedById  String?
  lockedBy    User?     @relation("PageLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  lockSubtree Boolean   @default(false)

  document       PageDocument?
  grants         PageGrant[]
  files          FileObject[]
  // Columns of the child-page table: defined on the parent, shared by every
  // table block placed on it.
  propertyDefs   PagePropertyDef[]
  // This page's values for its parent's columns.
  propertyValues PagePropertyValue[]
  versions       PageVersion[]
  searchIndex    PageSearchIndex?

  @@index([rootId])
  @@index([parentId, sortOrder])
}

// Persisted Yjs document state for a page, written by the collab (Hocuspocus) server.
// `state` is encrypted with the instance data encryption key (see InstanceConfig).
enum PropertyType {
  TEXT
  DATE
  USER
  SELECT
}

// A column of the child-page table on `pageId` (applies to its children).
// Name and SELECT options are encrypted with the DEK, AAD bound to the id
// (lib/page-properties.ts).
model PagePropertyDef {
  id        String       @id @default(cuid())
  pageId    String
  page      Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      PropertyType
  name      Bytes
  // SELECT only: JSON [{ id, name, color }].
  options   Bytes?
  position  Int
  createdAt DateTime     @default(now())

  values PagePropertyValue[]

  @@index([pageId])
}

// A child page's value for one of its parent's columns: encrypted JSON, AAD
// bound to (pageId, defId). No row means empty.
model PagePropertyValue {
  pageId    String
  page      Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  defId     String
  def       PagePropertyDef @relation(fields: [defId], references: [id], onDelete: Cascade)
  value     Bytes
  updatedAt DateTime        @updatedAt

  @@id([pageId, defId])
  @@index([defId])
}

enum PageVersionKind {
  // Saved while editing (every VERSION_INTERVAL_MS) and when everyone left.
  AUTO
  // The state found when a page was first opened after history existed.
  INITIAL
  // The state just before "restore this version" replaced it.
  BEFORE_RESTORE
  // The state right after a restore (restoredFromId = the version restored).
  RESTORED
}

// A saved state of a page's document (title + body), for page history. `state` is
// a full Yjs update encrypted with the DEK, AAD bound to (pageId, id)
// (apps/web/src/lib/page-versions.ts). The title is plaintext like Page.title.
model PageVersion {
  id             String          @id
  pageId         String
  page           Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  kind           PageVersionKind
  title          String
  // Users whose edits went into this version since the previous one.
  editorIds      String[]
  state          Bytes
  restoredFromId String?
  // Set when text in this version was masked (e.g. a password typed by
  // mistake): `state` and `title` were rebuilt with the text replaced, so the
  // version is shown masked and can no longer be restored. Versions are
  // never deleted (audit).
  maskedAt       DateTime?
  maskedById     String?

  @@index([pageId, createdAt])
}

// Full-text search index, one row per page: the page's text (title, body,
// attachment names) as keyed 64-bit hashes of its 1- and 2-character pieces
// (apps/web/src/lib/search-index.ts). No plaintext: a query is hashed the
// same way and matched with array containment; candidates are then decrypted
// to confirm the match and build snippets.
model PageSearchIndex {
  pageId    String   @id
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tokens    BigInt[]
  indexedAt DateTime @default(now())

  @@index([tokens], type: Gin)
}

model PageDocument {
  pageId    String   @id
  page      Page     @relation(fields: [pageId], references: [id])
  state     Bytes
  updatedAt DateTime @updatedAt
}

// Singleton row (id = 1) created by the first-run setup screen. Holds the
// data encryption key (DEK), wrapped twice — never stored in plaintext:
// - dekByPassword:  by a key derived from the master password (scrypt, kdfSalt/kdfParams)
// - dekByServerKey: by KNOWLECTIVE_SERVER_KEY, so processes can unlock it on startup
model InstanceConfig {
  id             Int   @id @default(1)
  kdfSalt        Bytes
  kdfParams      Json
  dekByPassword  Bytes
  dekByServerKey Bytes

  // Admin TOTP secret, encrypted with the DEK. Null until the first admin
  // login enrolls an authenticator app.
  totpSecret   Bytes?
  // Last accepted TOTP time step, so a code can't be replayed.
  totpLastStep Int?

  // Public origin of the site (e.g. https://knowlective.example.com), used for links
  // in emails and invitations. Null on instances set up before it existed.
  publicUrl String?

  // CIDRs allowed to reach /admin. Empty = no restriction.
  adminIpAllowlist String[] @default([])

  // Largest file an editor may attach, in MB. Independent of which storage
  // is used. Capped by MAX_FILE_SIZE_MB_LIMIT in apps/web/src/lib/storage.ts.
  maxUploadSizeMb Int @default(100)

  // File name extensions (lowercase, no dot) that may be attached.
  // Empty = no restriction. The default is RECOMMENDED_EXTENSIONS in
  // apps/web/src/lib/upload-types.ts; keep the two the same.
  uploadAllowedExtensions String[] @default(["avif", "bmp", "csv", "doc", "docx", "gif", "heic", "heif", "jpeg", "jpg", "json", "m4a", "markdown", "md", "mov", "mp3", "mp4", "odp", "ods", "odt", "ogg", "pdf", "png", "ppt", "pptx", "rtf", "tsv", "txt", "wav", "webm", "webp", "xls", "xlsx", "zip"])

  // Link previews: whether the server fetches the pages of pasted URLs,
  // whether private (intranet) addresses are fetched too, and the forward
  // proxy to fetch through (URL without credentials; the password is
  // encrypted with the DEK). apps/web/src/lib/link-preview-settings.ts.
  linkPreviewEnabled          Boolean @default(true)
  linkPreviewAllowPrivate     Boolean @default(false)
  linkPreviewProxyUrl         String?
  linkPreviewProxyUsername    String?
  linkPreviewProxyPasswordEnc Bytes?

  // Whether pages may be public: viewable without logging in, through the
  // built-in "public" group (packages/shared/src/permissions.ts). Off: grants
  // to that group count for nobody, and none can be added.
  publicPagesAllowed Boolean @default(false)
  // Whether search engines may index the site (public pages are what they
  // can reach). Off: every response says X-Robots-Tag: noindex, nofollow
  // (apps/web/server/robots.ts).
  searchEnginesAllowed Boolean @default(false)
  // The public page "/" shows someone not logged in (the landing page),
  // instead of the login screen. No foreign key: only used while the page is
  // public (checked on each visit), otherwise "/" asks to log in.
  landingPageId String?

  // How accounts are created: by invitation only, or also by anyone who
  // confirms their email address at /signup (needs mail settings).
  signupMode SignupMode @default(INVITE_ONLY)
  // OPEN only: email domains allowed to sign up (e.g. example.co.jp).
  // Empty = any domain.
  signupAllowedDomains String[] @default([])
  // Site role of accounts created by self-registration: USER or
  // CONTENT_MANAGER (never SITE_ADMIN). Applied when the account is created.
  signupSiteRole SiteRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdminSessionStage {
  // Master password verified, but no authenticator enrolled yet.
  ENROLL_TOTP
  // Account password verified; waiting for the authenticator code.
  VERIFY_TOTP
  // Fully authenticated (master password + TOTP).
  ACTIVE
}

// Admin (/admin) sessions, separate from regular user sessions. The cookie
// holds a random token; only its SHA-256 hash is stored here.
model AdminSession {
  tokenHash   String            @id
  // The signed-in SITE_ADMIN / CONTENT_MANAGER user.
  // Null = signed in with the master password (bootstrap / recovery).
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage       AdminSessionStage
  // TOTP secret being enrolled (ENROLL_TOTP stage only), encrypted with the DEK.
  pendingTotp Bytes?
  ip          String
  userAgent   String?
  createdAt   DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

// Every /admin login attempt, for rate limiting and the dashboard audit view.
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  // Email entered for an account login (encrypted, see User); null for
  // master password logins.
  emailHash   Bytes?
  emailEnc    Bytes?
  legacyEmail String?
  success   Boolean
  // e.g. "bad_credentials", "locked", "ip_denied"
  reason    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

// Regular user sessions (separate from AdminSession). The cookie holds a
// random token; only its SHA-256 hash is stored here.
model UserSession {
  tokenHash  String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

// Sign-up is invitation-only. Issued from /admin; the link carries a random
// token and only its SHA-256 hash is stored. Single use.
enum SignupMode {
  INVITE_ONLY
  OPEN
}

model Invitation {
  id        String  @id @default(cuid())
  tokenHash String  @unique
  // If set, only this email address may use the invitation (encrypted, see
  // User).
  emailHash   Bytes?
  emailEnc    Bytes?
  legacyEmail String?

  // Groups the invitee joins on accepting. Page access comes only from these.
  groups InvitationGroup[]

  // Site role given to the account created from this invitation.
  siteRole SiteRole @default(USER)

  // Created by /signup (self-registration) rather than by an admin: the
  // link was mailed to `email` to confirm it. No groups, USER role. Hidden
  // from the admin's pending invitations.
  selfSignup  Boolean @default(false)
  // selfSignup only: who asked, for rate limiting.
  requestedIp String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  usedById  String?
  usedBy    User?     @relation(fields: [usedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

// Every user login attempt, for rate limiting.
model UserLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  // The address entered, as its keyed hash only (see User): counted, never shown.
  emailHash   Bytes?
  legacyEmail String?
  success   Boolean
  userAgent String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([emailHash, createdAt])
}

// Password reset links: /reset-password/<token>. Mailed to the user from
// /forgot-password, or issued by a site admin in /admin/users (also the way
// in when mail isn't configured). Only the token's SHA-256 hash is stored.
// Rows are kept after use or expiry, for rate limiting.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Issued from /admin rather than requested at /forgot-password.
  issuedByAdmin Boolean @default(false)
  // /forgot-password only: who asked, for rate limiting.
  requestedIp String?

  createdAt DateTime  @default(now())
  // A newer link for the same user expires the older ones (sets this to now).
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, createdAt])
  @@index([requestedIp, createdAt])
}

enum SmtpSecurity {
  // Plain connection; never upgrade (only for trusted local relays).
  NONE
  // Plain connection upgraded with STARTTLS (usually port 587). Fails if the
  // server doesn't offer it, rather than silently sending in plaintext.
  STARTTLS
  // TLS from the first byte (usually port 465).
  TLS
}

// Outgoing mail (SMTP) settings, edited from /admin. Singleton row (id = 1).
model MailSettings {
  id          Int          @id @default(1)
  fromAddress String
  fromName    String?
  host        String
  port        Int
  security    SmtpSecurity
  authEnabled Boolean      @default(false)
  username    String?
  // SMTP password, encrypted with the DEK. Never sent back to the browser.
  passwordEnc Bytes?
  updatedAt   DateTime     @updatedAt
}

// User groups, managed from /admin. Groups exist to grant page tree
// permissions; site-wide roles are User.siteRole, not groups.
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // Set on built-in groups. "all_users": every enabled user is implicitly a
  // member (no GroupMember rows). "public": everyone, logged in or not, while
  // InstanceConfig.publicPagesAllowed is on; VIEW only. See permissions.ts.
  // Built-in groups can't be deleted or have members edited.
  builtIn     String?  @unique
  createdAt   DateTime @default(now())

  members     GroupMember[]
  grants      PageGrant[]
  invitations InvitationGroup[]
}

model GroupMember {
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// S3-compatible storage for file attachments, edited from /admin. Singleton
// row (id = 1). While absent, the bundled SeaweedFS from docker-compose.yml is
// used (credentials from SEAWEEDFS_* env vars).
//
// Changing it is an infrastructure task: existing objects are NOT migrated by
// the app. Object keys don't depend on these settings (keyPrefix + "files/" +
// FileObject.id), so copying the bucket is enough.
model StorageSettings {
  id                 Int      @id @default(1)
  endpoint           String
  // Null = derived from an AWS endpoint host, else "us-east-1".
  region             String?
  bucket             String
  accessKeyId        String
  // Encrypted with the DEK. Never sent back to the browser.
  secretAccessKeyEnc Bytes
  forcePathStyle     Boolean  @default(false)
  keyPrefix          String   @default("")
  updatedAt          DateTime @updatedAt
}

// An uploaded attachment. Content lives in object storage, encrypted with the
// DEK (AAD bound to the id). Served only through /api/files/<id> after a
// membership check on rootId.
model FileObject {
  id           String        @id @default(cuid())
  rootId       String
  root         KnowledgeRoot @relation(fields: [rootId], references: [id])
  // Page it was uploaded on (informational; access is decided by rootId).
  pageId       String?
  page         Page?         @relation(fields: [pageId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  name         String
  mimeType     String
  // Plaintext size in bytes.
  size         Int
  createdAt    DateTime      @default(now())

  @@index([rootId])
}

// Grants a group access to a page and, by inheritance, its descendants.
// Page access comes only from these — never from individual users or site
// roles. For one group, the grant nearest the page (walking up) wins, so a
// lower grant can narrow access (e.g. EDIT on the root, VIEW on a subtree).
// Across a user's groups the strongest access wins. See packages/shared/src/permissions.ts.
model PageGrant {
  id        String     @id @default(cuid())
  pageId    String
  page      Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  access    PageAccess
  createdAt DateTime   @default(now())

  @@unique([pageId, groupId])
  @@index([groupId])
}

model InvitationGroup {
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([invitationId, groupId])
}

// Who changed what, for permission-related changes: roles, account
// enable/disable, group membership, page grants, knowledge root creation.
// Kept even when the actor or target is deleted (no foreign keys), so it
// stays a faithful record. Shown to site admins in /admin/security.
model AuditLog {
  id         String   @id @default(cuid())
  // Null for the master password login.
  actorId    String?
  // e.g. "user.role", "user.disable", "group.member.add", "page.grant.set"
  action     String
  // The entry's text, encrypted with the DEK (AuditText in
  // src/personal-data.ts): actorLabel (name/email at the time, or
  // the master password's label), summary (human-readable, rendered as-is), detail.
  sealed     Bytes?
  // Plaintext of an entry from before the encryption; the server seals it
  // at startup and clears these.
  legacyActorLabel String?
  legacySummary    String?
  legacyDetail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Site colors set in /admin (one row, id = 1). Keys and defaults live in
// apps/web/src/lib/theme-tokens.ts; unknown or invalid entries are ignored,
// so tokens can be added without a migration.
model ThemeSettings {
  id        Int      @id @default(1)
  colors    Json
  updatedAt DateTime @updatedAt
}

enum PasswordLoginMode {
  // Password and OpenID Connect both work.
  ALLOWED
  // Only OpenID Connect, except site admins (so nobody gets locked out if
  // the IdP is down or misconfigured).
  SITE_ADMINS_ONLY
}

// Sign-in with OpenID Connect (one row, id = 1). apps/web/src/lib/auth/oidc.ts.
model OidcSettings {
  id              Int               @id @default(1)
  enabled         Boolean           @default(false)
  // Issuer URL; its /.well-known/openid-configuration is fetched.
  issuer          String
  clientId        String
  // Client secret, encrypted with the DEK. Never sent back to the browser.
  clientSecretEnc Bytes
  // Label of the login button ("Log in with …").
  buttonLabel     String
  // Claim used as a new account's display name (e.g. "name", "given_name").
  // Null = "name", else "preferred_username". Fetched from the UserInfo
  // endpoint if the ID token doesn't have it.
  nameClaim       String?
  // New users are created on their first sign-in with this role
  // (USER or CONTENT_MANAGER), if their email domain is allowed.
  newUserRole     SiteRole          @default(USER)
  // Empty = any domain.
  allowedDomains  String[]          @default([])
  // Treat the IdP's email as verified even without email_verified: true
  // (e.g. Microsoft Entra ID omits it). Only for IdPs that control emails.
  trustEmail      Boolean           @default(false)
  passwordLogin   PasswordLoginMode @default(ALLOWED)
  updatedAt       DateTime          @updatedAt
}

